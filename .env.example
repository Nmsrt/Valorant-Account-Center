VITE_SUPABASE_URL=https://your_project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: HenrikDev API key for the fast first-choice rank source (/api/rank).
# Get a free key via the HenrikDev Discord (https://docs.henrikdev.xyz).
